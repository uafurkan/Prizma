# Public site URL, used for robots.txt, sitemap.xml, canonical URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://prizma.monster

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave unset to
# disable AdSense entirely - also used to generate /ads.txt.
NEXT_PUBLIC_ADSENSE_ID=

# AdSense ad unit ("ad slot") IDs, one per placement shape used across the
# site (see components/AdSlot.tsx). Each is reused by every placement of
# that shape. Leave any of these unset to skip rendering that ad shape.
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_RESPONSIVE=
